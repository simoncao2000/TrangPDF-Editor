{
  "name": "pdf-editor",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --filter web dev",
    "build": "bun --filter web build",
    "typecheck": "bun check",
    "lint": "eslint packages apps/web/src",
    "test": "bun test packages",
    "format": "prettier --write packages apps eslint.config.js",
    "format:check": "prettier --check packages apps eslint.config.js"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
