{
  "name": "pdf-editor",
  "type": "module",
  "private": true,
  "scripts": {
    "story": "storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "dev": "bun --filter web dev",
    "build": "bun --filter web build",
    "typecheck": "bun check",
    "lint": "eslint packages apps/web/src",
    "test": "bun test packages test-corpus",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .git/info/exclude --ignore-path .prettierignore",
    "build-storybook": "storybook build --disable-telemetry",
    "test-storybook": "bun run build-storybook && bun .storybook/smoke.ts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "latest",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.15.0",
    "playwright": "^1.60.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
